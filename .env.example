# Copy this file to .env and fill in real values, or export these
# directly in your shell / CI secrets. dispatch reads plain env vars —
# it does not load .env itself, so `set -a && source .env && set +a`
# (or a tool like `direnv`/`python-dotenv` in your own shell) before
# running commands.

# ==============================================================================
# 1. Required Credentials & Senders
# ==============================================================================
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
FROM_EMAIL=no-reply@domain.tld

# ==============================================================================
# 2. Brand & Sender Options (Optional)
# ==============================================================================
FROM_NAME=YourName
REPLY_TO=support@domain.tld

# ==============================================================================
# 3. Advanced Engine Tuning (Optional — sensible defaults shown)
# ==============================================================================
# Where the SQLite state file lives (can also be passed via `--db <path>`)
# DISPATCH_DB_PATH=dispatch.db

# Resend API rate limiter (requests/sec). A batch call of up to 100 emails counts as 1 request.
# RATE_LIMIT_PER_SECOND=8
# MAX_BATCH_SIZE=100

# Retry policy for transient failures (5xx, 429, network timeouts)
# MAX_ATTEMPTS=5
# BASE_BACKOFF_SECONDS=2
# MAX_BACKOFF_SECONDS=600

# Enqueue deliverability validation (syntax + MX + RFC 7505 Null MX checks).
# Requires `dnspython` (or pass `--skip-validation` to disable).
# VALIDATE_DELIVERABILITY=true
# MX_LOOKUP_TIMEOUT_SECONDS=3
